# 监听端口
PORT=8787
# SQLite 文件位置（相对 server/ 目录）
DB_PATH=data/portal.db
# 允许携带 Cookie 的前端来源，逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://liguannan-alex.github.io
# 本地 http 开发置 false；线上必须为 true（否则 Cookie 不带 Secure）
COOKIE_SECURE=false
# 可访问 /api/stats 的管理员用户名，逗号分隔
ADMIN_USERNAMES=hdadmin

# ── 工作流编排层 ────────────────────────────────────────────────
# 演示算力开关。true 时未接入的算力回落到占位产出，便于在拿到凭据前演示。
# 线上必须置为 false，否则用户会拿到占位图当成真实产出。
WORKFLOW_ALLOW_MOCK=true
# 演示算力的模拟等待毫秒数
WORKFLOW_MOCK_DELAY_MS=1500
# 同时在跑的任务数上限（每个在跑任务都对应第三方算力计费）
WORKFLOW_CONCURRENCY=2
# 每人每日可消耗额度，按工作流 costCredits 累加
WORKFLOW_DAILY_CREDITS=30
# 同一用户未完成任务数上限
WORKFLOW_PENDING_LIMIT=3
# 单任务最长执行时间（秒）
WORKFLOW_RUN_TIMEOUT_SECONDS=600
# 轮询第三方作业状态的间隔（秒）
WORKFLOW_POLL_INTERVAL_SECONDS=5
# 队列扫描间隔（秒）
WORKFLOW_TICK_INTERVAL_SECONDS=2

# 第三方算力凭据。两项都填齐后 liblib 提供方才会被判为已接入。
# 注意：下方字段映射尚未与厂商接口文档逐字段核对，接入前须先核对再启用。
# WORKFLOW_LIBLIB_BASE_URL=
# WORKFLOW_LIBLIB_API_KEY=
# WORKFLOW_LIBLIB_SUBMIT_PATH=/api/generate
# WORKFLOW_LIBLIB_STATUS_PATH=/api/generate/{jobId}
# WORKFLOW_LIBLIB_JOB_ID_FIELD=data.generateUuid
# WORKFLOW_LIBLIB_STATUS_FIELD=data.generateStatus
# WORKFLOW_LIBLIB_OUTPUT_FIELD=data.images
# WORKFLOW_LIBLIB_SUCCESS_VALUES=5,success,succeeded
# WORKFLOW_LIBLIB_FAILURE_VALUES=6,7,failed,error
